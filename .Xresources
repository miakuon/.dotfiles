! ============================================================
!  ~/.Xresources
!  Настройки шрифтов, терминалов (XTerm), цветовая схема
! ============================================================


! ============================================================
!  HiDPI — раскомментировать если экран 4K
! ============================================================

Xft.dpi:        180
Xft.autohint:   0
Xft.lcdfilter:  lcddefault
Xft.hintstyle:  hintfull
Xft.hinting:    1
Xft.antialias:  1
Xft.rgba:       rgb


! ============================================================
!  XTerm
! ============================================================

! -- Шрифт --
! Варианты (раскомментировать нужный):
!XTerm*faceName: DejaVu Sans Mono:size=12
!XTerm*faceName: xft:Mononoki Nerd Font, \
!                xft:JoyPixels:size=12,  \
!                xft:Monospace:style=Medium:size=12
XTerm*faceName:   Adwaita:size=12
XTerm*faceSize:   11
XTerm*renderFont: true

! -- Поведение --
XTerm*loginShell:        true   ! каждый шелл — логин-шелл (подхватывает все переменные окружения)
XTerm*dynamicColors:     true
XTerm*utf8:              2
XTerm*locale:            true
XTerm*saveLines:         16384

! -- Прокрутка --
XTerm*scrollKey:         true   ! прокрутка при нажатии клавиш
XTerm*scrollBar:         false
XTerm*scrollBar.width:   8
XTerm*rightScrollBar:    true   ! было опечатка: rightScrolBar → rightScrollBar

! -- Интерфейс --
XTerm*toolBar:           false
XTerm*selectToClipboard: true
XTerm*reverseVideo:      false

! -- Горячие клавиши --
XTerm*translations: #override         \n\
    Ctrl <Key>-: smaller-vt-font()    \n\
    Ctrl <Key>=: larger-vt-font()     \n\
    Ctrl <Key>V: insert-selection(CLIPBOARD) \n

! -- Выделение двойным кликом: захватывает URL целиком --
XTerm*charClass: 33:48,36-47:48,58-59:48,61:48,63-64:48,95:48,126:48

! ============================================================
!  Цветовая схема — Catppuccin Mocha
! ============================================================

XTerm*foreground:  #cdd6f4
XTerm*background:  #1e1e2e
XTerm*cursorColor: #f5e0dc

! Чёрный (Surface1)
XTerm*color0:  #45475a
XTerm*color8:  #585b70

! Красный
XTerm*color1:  #f38ba8
XTerm*color9:  #f38ba8

! Зелёный
XTerm*color2:  #a6e3a1
XTerm*color10: #a6e3a1

! Жёлтый
XTerm*color3:  #f9e2af
XTerm*color11: #f9e2af

! Синий
XTerm*color4:  #89b4fa
XTerm*color12: #89b4fa

! Пурпурный (Pink)
XTerm*color5:  #f5c2e7
XTerm*color13: #f5c2e7

! Голубой (Sky)
XTerm*color6:  #89dceb
XTerm*color14: #89dceb

! Белый (Subtext0)
XTerm*color7:  #a6adc8
XTerm*color15: #cdd6f4
